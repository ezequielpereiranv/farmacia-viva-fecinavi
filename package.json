{
  "name": "farmacia-viva-espaco-escolar",
  "version": "2.0.0",
  "description": "Farmácia Viva no Espaço Escolar - FeciNAVI Naviraí-MS",
  "main": "electron-main.js",
  "author": "E.E. Presidente Médici",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "desktop": "electron ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.ms.medici.feiraciencias",
    "productName": "Farmácia Viva no Espaço Escolar",
    "asar": true,
    "files": [
      "electron-main.js",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Feira de Ciências"
    },
    "portable": {
      "artifactName": "Pesquisa-Feira-Ciencias-Portatil-${version}.exe"
    }
  }
}